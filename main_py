import asyncio
asyncio.set_event_loop(asyncio.new_event_loop())
import os
from pyrogram import Client, filters
from pyrogram.types import InlineKeyboardMarkup, InlineKeyboardButton

API_ID = int(os.environ.get("API_ID"))
API_HASH = os.environ.get("API_HASH")
BOT_TOKEN = os.environ.get("BOT_TOKEN")

FORCE_CHANNELS = ["p20setupallfils", "p20_letest"]
STORE_CHANNEL = "p20setupallfils"

app = Client("memories_bot", api_id=API_ID, api_hash=API_HASH, bot_token=BOT_TOKEN)

async def check_join(client, user_id):
    for ch in FORCE_CHANNELS:
        try:
            m = await client.get_chat_member(ch, user_id)
            if m.status in ["left", "kicked"]:
                return False
        except:
            return False
    return True

def join_keyboard():
    buttons = []
    for ch in FORCE_CHANNELS:
        buttons.append([InlineKeyboardButton(f"Join @{ch}", url=f"https://t.me/{ch}")])
    buttons.append([InlineKeyboardButton("✅ I Joined - Check Again", callback_data="check_join")])
    return InlineKeyboardMarkup(buttons)

@app.on_message(filters.command("start") & filters.private)
async def start(client, message):
    joined = await check_join(client, message.from_user.id)
    if not joined:
        await message.reply_text("👋 Welcome! Pehle channels join karo, fir Check Again dabao.", reply_markup=join_keyboard())
